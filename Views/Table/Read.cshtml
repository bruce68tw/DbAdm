<script @_Fun3.Script("Table")></script>
<vc:xg-prog-path />
<div class="x-prog">
    <!-- read form-->
    <div id="divRead">
        <!-- condition -->
        <form id='formRead' class='x-form mb-0'>
            <div class="row">
                <vc:xi-select dto='new() { Title = "專案", Fid = "ProjectId", Rows = ViewBag.Projects, InRow = true }' />
                <vc:xg-find-tbar dto='new() { HasReset = true, HasFind2 = true }' />
            </div>
            <vc:xi-text dto='new() { Title = "資料表", Fid = "Code", MaxLen = 30 }' />
        </form>
        <form id='formRead2' class='x-form'>
            <vc:xi-text dto='new() { Title = "資料表名稱", Fid = "Name", MaxLen = 30 }' />
            <vc:xi-select dto='new() { Title = "異動記錄", Fid = "TranLog", Rows = ViewBag.YesNos }' />
            <vc:xi-select dto='new() { Title = "資料狀態", Fid = "Status", Rows = ViewBag.Statuses }' />
        </form>

        <div class='x-btns-box mt-1'>
            <vc:xg-create />
            <vc:xg-export />
            <button type="button" class="btn btn-secondary" data-onclick="_vo.onGenWord">產生文件</button>
        </div>

        <!-- result list -->
        <table id="tableRead" class="table table-bordered x-table" cellspacing="0">
            <thead>
                <tr>
                    <th width="60px">選取</th>
                    <th>專案</th>
                    <th>資料庫</th>
                    <th>資料表</th>
                    <th>資料表名稱</th>
                    <th>建檔人員</th>
                    <th width='90px'>異動記錄</th>
                    <th width='110px'>資料狀態</th>
                    <th width='90px'>維護</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <!-- edit form-->
    <div id="divEdit" class="d-none">
        <partial name="Edit" />
    </div>
</div>